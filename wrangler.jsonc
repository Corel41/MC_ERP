{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mc-erp",
  // Set to the date the project was created; review runtime changes before advancing it.
  "compatibility_date": "2026-10-27",
  "assets": {
    // Produced by `npm run build:public` — never edit by hand, never point at the repo root.
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
