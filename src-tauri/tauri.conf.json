{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MC ERP",
  "version": "1.0.0",
  "identifier": "com.metrocosmo.mcerp",
  "build": {
    "frontendDist": "../"
  },
  "app": {
    "windows": [
      {
        "title": "METROCOSMO ERP",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "transparent": true,
        "theme": "Dark",
        "decorations": true,
        "windowEffects": {
          "effects": [
            "micaDark",
            "acrylic",
            "blur"
          ]
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
